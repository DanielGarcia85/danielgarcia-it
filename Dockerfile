# Dockerfile
# danielgarcia.it — image of the site: generated by Roq, then served by Nginx
# ─────────────────────────────────────────────────────────────────────────────
# Built in two stages: the first one runs the tests and generates the static
# site with Java and Maven, the second one only keeps the generated files and
# Nginx. Java, Maven and the sources are not part of the final image.

# ── Stage 1: test and generate the site ───────────────────────────────────────

# Official Eclipse Temurin image: Java 25 JDK on Ubuntu 24.04, the Java version
# the project is compiled for. The tag follows the fixes of Java 25.
FROM eclipse-temurin:25-jdk-noble AS build

# The Maven Wrapper checks the SHA-256 of the Maven .zip, but downloads the
# .tar.gz instead when unzip is missing, and the check then always fails.
# This image has no unzip: it is installed, so that the check stays on.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends unzip \
    && rm -rf /var/lib/apt/lists/*

# Folder of the project inside this stage
WORKDIR /app

# Sources, limited to what .dockerignore lets in
COPY . .

# Tests, then packaging of the Quarkus application. SKIP_TESTS=true skips the
# tests, for a pipeline that has already run them on the same commit. The cache
# mount keeps Maven's downloads between builds, outside the image.
ARG SKIP_TESTS=false
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -DskipTests=${SKIP_TESTS} package

# Generation. Roq's batch mode is fixed when the application is built, not when
# it starts: the application is built again with it, without running the tests
# a second time, then started; it writes every page into target/roq and stops.
RUN --mount=type=cache,target=/root/.m2 \
    QUARKUS_ROQ_GENERATOR_BATCH=true ./mvnw -B -DskipTests package quarkus:run

# ── Stage 2: serve the generated site ─────────────────────────────────────────

# Official Nginx image, stable branch, on Alpine Linux: small, no Java
FROM nginx:stable-alpine

# Files of the image itself (welcome page, 50x.html) are removed: only the
# generated site is served
RUN rm -rf /usr/share/nginx/html/*

# Generated site, taken from the first stage
COPY --from=build /app/target/roq /usr/share/nginx/html

# Our configuration replaces the default site of the image
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Port Nginx listens on. Declared for documentation: nothing is published
# to the outside from here.
EXPOSE 80
